{
  "outputDirectory": "doc_build",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "CN"
        }
      ],
      "destination": "https://opensource.onixbyte.cn/:path*",
      "permanent": false
    }
  ]
}
